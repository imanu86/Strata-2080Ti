+++ b/src/prefill/prefill.cpp
@@ -1908,7 +1908,8 @@ bool Prefill::relayout(int64_t chunk, void* borrow, uint64_t borrow_bytes, std::
         err = "prefill: device buffers for a chunk of " + std::to_string(chunk) + " tokens do not fit (" +

+                                 "[--rows] [--no-dense]\n");
+            return 2;
+        }
+    }
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices == 0) {
+        std::puts("SKIP: no GPU");

diff --git a/include/strata/core/verify.hpp b/include/strata/core/verify.hpp
index 4ad2a4c0..10b3246c 100644
--- a/include/strata/core/verify.hpp
+++ b/include/strata/core/verify.hpp
@@ -209,6 +209,10 @@ public:
     // Greedy only, no drafts (MTP) in a batch window.  `init_slots` once after `init` (S <= max_t); a layer

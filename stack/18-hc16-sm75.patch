+/// BF16X2's low parts (an explicit accuracy option) keep the BF16 path.  `carve` and `bytes_needed_impl` both ask this.
+inline bool hc16_alloc(bool f16_io) { return hc16_dev() && !bf16x2_hc(f16_io); }
